# Base .zshrc should mostly be OhMyZSH setup, and this is more general
# things to run after it.  Note that LLM agents won't have access to that;
# if that is needed, look at putting it in .zshenv

# Starship
if type "starship" > /dev/null; then
    eval "$(starship init zsh)"
fi

# Editors
if type "code" > /dev/null; then
  export EDITOR=code
fi
if type "code-insiders" > /dev/null; then
  export EDITOR=code-insiders
fi

# Personal aliases
#####
alias ls='ls -Gah1'
alias mkdir='mkdir -p'
alias reload='exec zsh'
alias cleardns='dscacheutil -flushcache'
alias locate-update='/usr/libexec/locate.updatedb'
alias python-http='python -m SimpleHTTPServer 8000'
alias download='curl -O'
alias airport='/System/Library/PrivateFrameworks/Apple80211.framework/Versions/Current/Resources/airport'
alias preview='qlmanage -p'

# LS with coreutils
if type "gls" > /dev/null; then
  eval $( gdircolors -b $HOME/.dircolors );
  alias ls='gls -Gah1 --color';
fi

# User specific rc that shouldn't be in version control.
if [ -e $HOME/.zshrc-user ]; then
  source ~/.zshrc-user
fi
